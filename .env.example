# Copy to $GUTNUMBER_PRIVATE_DIR/.env (or ./.env for a single-repo install).
GUTNUMBER_DATA_DIR=/home/you/gutnumber-data
GUTNUMBER_PRIVATE_DIR=/home/you/gutnumber_pvt
PORT=3100
PUBLIC_URL=https://gut.example.com
TZ=America/Los_Angeles
DAILY_HOUR=6
WEEKLY_DAY=1
# Residential proxy. {session} is replaced by 8 random chars per request.
PROXY_URL_TEMPLATE=
PROXY_COUNTRIES=
BROWSER_CONCURRENCY=1
HTTP_CONCURRENCY=4
YOUTUBE_API_KEY=
CLICKY_SITE_ID=
CLICKY_SITEKEY=
TYPESAFE_API_KEY=
PUSHOVER_USER=
PUSHOVER_TOKEN=
